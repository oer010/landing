{
  "name": "vfr-flyapp",
  "version": "0.1.0",
  "description": "VFR-flyapp: kart, ruteplanlegging, vær, masse og balanse og E6B",
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/fir.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios:sync": "npm run build && cap sync ios",
    "ios": "npm run build && cap sync ios && cap open ios",
    "pages": "node scripts/sync-data.mjs && npm run build && rm -rf ../vfr && cp -r dist ../vfr && rm -f ../vfr/_redirects"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "geomagnetism": "^0.2.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.22",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "private": true,
  "type": "module"
}
